rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /travelNameSpins/{nameHash} {
      // Không cần tài khoản Google. Mỗi tên có một mã SHA-256 cố định.
      // Người tham gia có thể xem kết quả cho tên mình nhập, nhưng không thể liệt kê cả bộ dữ liệu.
      allow get: if true;
      allow list: if false;
      // Tạo một lần, không cho sửa hoặc xóa (chỉ project owner có thể thao tác trong Console).
      allow create: if nameHash.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasAll(['name','resultIndex','result','createdAt'])
        && request.resource.data.keys().hasOnly(['name','resultIndex','result','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.resultIndex is int
        && request.resource.data.resultIndex >= 0
        && request.resource.data.resultIndex <= 3
        && (
          (request.resource.data.resultIndex == 0 && request.resource.data.result == 'München') ||
          (request.resource.data.resultIndex == 1 && request.resource.data.result == 'Düsseldorf & Köln') ||
          (request.resource.data.resultIndex == 2 && request.resource.data.result == 'Berlin & Prague') ||
          (request.resource.data.resultIndex == 3 && request.resource.data.result == 'Hamburg')
        )
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}